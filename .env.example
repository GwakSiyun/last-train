# 서울 열린데이터광장 일반 인증키 (역 시간표·역 목록) — 서버 전용
SEOUL_OPEN_API_KEY=

# 공공데이터포털 한국천문연구원 특일 정보 (공휴일 자동 판별, 없으면 수동 선택) — 서버 전용
DATA_GO_KR_SERVICE_KEY=

# ODsay URI(도메인) 플랫폼 키 — 브라우저에서 호출 (배포용, 도메인 제한 키라 노출 전제)
NEXT_PUBLIC_ODSAY_WEB_KEY=

# ODsay Server 플랫폼 키 — 등록한 IP에서만 동작 (로컬 개발용, 위 키가 있으면 사용 안 함)
ODSAY_API_KEY=
